// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`check.timestamps given: [case1] a staged markdown file that holds a timestamp when: [t0] the gate runs then: the words a human reads are pinned 1`] = `
"✋ ConstraintError: timestamps are forbidden in tracked files, prose and docs included. remove them, zero exceptions
   ├─ why: a timestamp is a privacy leak, and churns every diff
   └─ lessons.md:3:book-a-lesson reminder sent 2026-09-29THH:MM:SSZ
"
`;

exports[`check.timestamps given: [case4] a staged file whose blob git cannot read when: [t0] the gate runs then: the words a human reads are pinned 1`] = `
"<a line from git>
💥 MalfunctionError: check.timestamps could not read the staged blob
   └─ lessons.md
"
`;
