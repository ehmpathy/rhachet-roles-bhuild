exports[`check.secrets given: [case4] a shape whose regex grep cannot parse when: [t0] the gate runs then: the halt matches the snapshot 1`] = `
"<a line from grep>
💥 MalfunctionError: check.secrets could not scan for a key shape
   ├─ shape: private key block
   ├─ grep exit: 2
   └─ fix: repair the regex for this shape in .husky/check.secrets.sh
"
`;

