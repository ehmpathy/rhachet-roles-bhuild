{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "incremental": false
  },
  "include": [
    "src/**/*.ts",
    "nontyped_modules/**/*.d.ts"
  ],
  "exclude": [
    "**/*.test.ts", // all explicitly .test files are dev only assets too
    "**/*.test.js",
    // a *.harness.ts is a dev-only asset by construction: the temp-dir, teardown, and runner
    // fixtures a suite imports. it carries no `.test` in its name (jest would run it as a
    // suite), so no rule above matches it (repo-local; clamped by buildBoundary)
    "**/*.harness.ts",
    "**/.test/**/*",
    "**/.scratch/**/*",
    "**/__test*__/**/*", // legacy dunder test dirs; new test assets live under .test
    "rhachet.use.ts" // repo-local: the rhachet use manifest is no shipped module
  ]
}
