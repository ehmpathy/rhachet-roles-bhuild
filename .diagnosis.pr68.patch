+
+      then('every number-sensitive word agrees with the count of one', () => {
+        // .why = r10 named two `(s)` sites; a structural sweep of the whole message found
+        //        six more words that assume a plural. to fix only the reported two would
+        //        leave "github serves them ... set them here ... their declared values"
+        //        beside a count of 1 — the same blemish, one line down.
+        expect(message).toContain('github serves it on');
+        expect(message).toContain('refuses it on');
+        expect(message).toContain('the one below must be set by hand');
+        expect(message).toContain('set it here');
+        expect(message).toContain('to its declared value');
+        expect(message).toContain('every future plan guards it.');
