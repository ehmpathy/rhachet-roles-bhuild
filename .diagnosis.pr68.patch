+        //        "1 member privilege(s) ... set the 1 control(s) above" — not english,
+        //        and read by an operator at the moment their apply halted. the three
+        //        peers had the identical shape and only ever rendered n=3, so it stayed
+        //        invisible (`rule.forbid.snapshot-visual-blemishes`).
+        expect(message).toContain(
+          '1 member privilege cannot be set via the GitHub API',
+        );
+        expect(message).toContain('set the 1 control above');
+        expect(message).not.toContain('(s)');
