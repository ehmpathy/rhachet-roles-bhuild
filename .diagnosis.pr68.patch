+          'allow members to delete or transfer repositories',
+        );
+      });
+
+      then('it still names the field, for whoever reads the code', () => {
+        expect(message).toContain('membersCanDeleteRepositories');
+      });
+
+      then('it states which way to move the control', () => {
+        expect(message).toContain('detected true, declared false');
+      });
+
+      then(
+        'it carries a direct link, not a description of where to look',
+        () => {
