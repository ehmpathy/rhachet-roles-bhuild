// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`radio.task.comment via gh.issues given: [case1] a comment on a real issue when: [t0] the body is not yet on the thread then: the live posted output matches the snap, run-minted bytes masked 1`] = `
"🪨 run solid skill repo=bhuild/role=dispatcher/skill=radio.task.comment

🦫 onto the pile!

🎙️ posted: comment on #<exid>
   ├─ url: https://github.com/ehmpathy/rhachet-roles-bhuild-demo/issues/<exid>#issuecomment-<id>
   ├─ via: gh.issues
   └─ recorded: .behavior/.radio/"
`;

exports[`radio.task.comment via gh.issues given: [case1] a comment on a real issue when: [t1] the same body is commented from a fresh record dir, as a second clone would then: the live kept output matches the snap, run-minted bytes masked 1`] = `
"🪨 run solid skill repo=bhuild/role=dispatcher/skill=radio.task.comment

🦫 already delivered

🎙️ kept: comment on #<exid> (already on the thread — naught posted)
   ├─ url: https://github.com/ehmpathy/rhachet-roles-bhuild-demo/issues/<exid>#issuecomment-<id>
   ├─ via: gh.issues
   └─ recorded: .behavior/.radio/"
`;

exports[`radio.task.comment via gh.issues given: [case2] a comment on an issue that does not exist when: [t0] the clone comments on an absent thread then: the live refused output matches the snap 1`] = `
"🪨 run solid skill repo=bhuild/role=dispatcher/skill=radio.task.comment

🦫 refused upstream
   ├─ comment = #99999999
   ├─ into    = ehmpathy/rhachet-roles-bhuild-demo
   ├─ status  = REFUSED (#99999999 not found in ehmpathy/rhachet-roles-bhuild-demo; check --exid and --into, then comment again) — closed, never retried
