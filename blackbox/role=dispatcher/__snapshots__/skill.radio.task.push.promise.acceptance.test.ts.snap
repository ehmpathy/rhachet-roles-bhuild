exports[`radio.task.push — the promise gate, via a stub gh given: [case9] refusals, help, and the stop line (stub: PUBLIC) when: [t4] both --help outputs then: each names the promise 1`] = `
"🪨 run solid skill repo=bhuild/role=dispatcher/skill=radio.task.push

🦫 let's check the meter...

🎙️ radio.task.push --help
   ├─ usage
   │  ├─ rhx radio.task.push --via gh.issues --into owner/repo --title "..." --description "..."
   │  ├─ rhx radio.task.push --via os.fileops --into @this --exid 123 --status CLAIMED
   │  ├─ rhx radio.task.push --via gh.issues --into owner/repo --exid 599 --status CLAIMED --auth as-human
   │  ├─ echo "details" | rhx radio.task.push --via gh.issues --into @this --title "..." --description @stdin
   │  └─ rhx radio.task.push --via gh.issues --into owner/public-repo --title "..." --description "..." --promise task-to-public-repo-is-anonymized
   │
   ├─ held, never lost
   │  ├─ every push is recorded first, into $route/.radio/ (or .behavior/.radio/)
   │  ├─ a shut gate or an upstream fault holds it QUEUED, exit 2
   │  ├─ the next push that gets through delivers the backlog first, oldest first
   │  ├─ see what waits: rhx radio.task.queue get
   │  └─ lift a shut gate (human): rhx radio.uses allow
   │
   ├─ a public repo needs a promise
   │  ├─ a title or body sent to a public repo cannot be taken back
   │  ├─ with no --promise, a push with text into a public repo stops before the send
   │  │  ├─ so does one into a repo whose visibility cannot be read
   │  │  └─ exit 2, a nudge, and this push is DROPPED: naught sent, naught queued
   │  ├─ check the text holds no private detail, then re-run the printed command
   │  └─ status-only updates and os.fileops need no promise
   │
   └─ options
      ├─ --via         channel: gh.issues or os.fileops (required)
      ├─ --into        target: @this (current repo) or owner/repo (required)
      ├─ --title       task title (required for new tasks)
      ├─ --description task description (required for new tasks; supports @stdin)
      ├─ --exid        external id for updates
      ├─ --status      status: QUEUED, CLAIMED, DELIVERED
      ├─ --idem        idempotency: findsert or upsert
      ├─ --auth        mode: as-robot:via-keyrack(owner) | as-robot:env(VAR) | as-robot:shx(cmd) | as-human
      ├─ --promise     task-to-public-repo-is-anonymized (needed for text into a public repo)
      └─ --help, -h    show this help"
`;

exports[`radio.task.push — the promise gate, via a stub gh given: [case9] refusals, help, and the stop line (stub: PUBLIC) when: [t4] both --help outputs then: each names the promise 2`] = `
"🪨 run solid skill repo=bhuild/role=dispatcher/skill=radio.task.queue

🦫 let's check the meter...

🎙️ radio.task.queue --help
   ├─ usage
   │  ├─ rhx radio.task.queue get                                   what waits: uuid · task · reason · fix
   │  ├─ rhx radio.task.queue get --when hook.onStop                one-line stop reminder (naught when none)
   │  ├─ rhx radio.task.queue set   --uuid <uuid> --auth as-human   amend one held record (or --description)
   │  ├─ rhx radio.task.queue del   --uuid <uuid> --why "<why>"     drop one, its body and why kept
   │  ├─ rhx radio.task.queue drain [--auth as-human]               deliver now; a fault sets one record aside
   │  └─ rhx radio.task.queue drain --promise task-to-public-repo-is-anonymized
   │     └─ deliver now, and vouch for every held public record
   │
   ├─ the line
   │  ├─ a rate limit or a github outage halts the drain; the rest wait in order
   │  ├─ any other fault sets its one record aside; the rest still deliver
   │  ├─ a later update to the same issue waits behind it, unsent, until it lands or is dropped
   │  └─ a record with text bound for a public repo, and no promise, awaits one
   │     ├─ read it at its record file first
   │     └─ then \`drain --promise\`, which promises every held public record
   │
   ├─ exit codes
   │  ├─ drain
   │  │  ├─ 0  naught waits, naught refused
   │  │  └─ 2  a record still waits, or this drain refused one (its why is in the output)
   │  └─ get, set, del
   │     └─ 0  done, even with records held; 2 only on a bad call
   │
   └─ options
      ├─ --uuid         the record uuid \`get\` prints (set, del)
      ├─ --auth         as-robot:via-keyrack(owner) | as-robot:env(VAR) | as-robot:shx(cmd) | as-human
      │  ├─ set:   amends the one record --uuid names
      │  └─ drain: sends every held record under this auth, this drain only
      ├─ --description  the new body (set; supports @stdin)
      ├─ --why          why the record is dropped (del, required)
      ├─ --promise      task-to-public-repo-is-anonymized (drain): promises every held public record
      │  └─ this drain sends, this drain only; never stored on a record
      ├─ --when         hook.onStop (get)
      └─ --help, -h     show this help"
`;

