// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`phone skills given: [case1] a shell with no enrolled clone when: [t0] phone.text get runs then: the refusal matches its snapshot 1`] = `
"🪨 run solid skill repo=bhuild/role=dispatcher/skill=phone.text

🪨 run solid skill repo=bhuild/role=dispatcher/skill=phone.text
   └─ ✋ blocked by constraints

🦫 bummer, no clone holds this phone

✋ ConstraintError: the phone runs only inside an enrolled clone
   ├─ RHACHET_CLONE_SERIAL is not set in this shell
   ├─ run it from a clone: rhx enroll claude --as @:<slug>
   └─ a human who grants a clone its contacts: lift the meter here, then the clone grants
      ├─ rhx phone.contacts.uses allow
      └─ then, in the clone: rhx phone.contacts set --address <address>"
`;

exports[`phone skills given: [case1] a shell with no enrolled clone when: [t1] phone.text --help runs then: it exits 0 and shows the three verbs and the address forms 1`] = `
"🪨 run solid skill repo=bhuild/role=dispatcher/skill=phone.text

🦫 here's how the phone works

💧 phone.text --help
   ├─ usage
   │  ├─ phone.text set --to <address> --what <text|@stdin> [--re <uuid>]   send a text (--to repeats for a group)
   │  ├─ phone.text get [--text <uuid>]                                      this clone's thread, or one text
   │  └─ phone.text del --text <uuid>                                        withdraw a QUEUED text
   │
   ├─ the address
   │  ├─ phone://grove=<grove>/tree=<tree>/clone=<clone>
   │  ├─ phone://grove=local/tree=<tree>/clone=<clone>   (local = this grove)
   │  └─ @:<clone>                                       (a clone in your own tree)
   │
   └─ a text is named by its uuid: the first 8 chars (7f3e9a02) or the whole"
`;

exports[`phone skills given: [case2] the phone.contacts.uses meter, unset when: [t0] a human reads it, a clone tries to lift it, then a human lifts it then: each step matches its snapshot 1`] = `
