exports[`tally.reviews.peer (acceptance) given: [case1] a route with reports from three lanes when: [t2] --help is asked then: the guide matches its snapshot 1`] = `
"🦫 oh, behave!

🌲 tally.reviews.peer --help
   ├─ usage
   │  ├─ tally.reviews.peer --route <dir>                       tally what each peer lane found on a route
   │  ├─ tally.reviews.peer --route <dir> --by rule             tally points per cited rule
   │  └─ tally.reviews.peer --route <dir> --lane-with <filter>  narrow to one lane
   │
   ├─ options
   │  ├─ --route <dir>         the route dir to tally                           (required)
   │  ├─ --by <axis>           lane (counts per lane) | rule (points per rule)  (default: lane)
   │  ├─ --lane-with <filter>  keep reports whose filename holds this string    (default: all lanes)
   │  ├─ --lane-wout <a,b>     drop reports whose filename holds any of these   (default: none)
   │  └─ --help, -h            show this help
   │
   └─ reads
      ├─ b=N n=N: the blockers and nitpicks a lane raised, summed over its reports
      ├─ by lane: many reports and 0 blockers = budget rounds spent, no defect found
      ├─ by rule: a rule absent from the rows was cited 0 times in the corpus
      ├─ --lane-wout: give the flag once; join its values with commas
      ├─ exit 2: the call is wrong — its route, its filters, or an empty corpus
      └─ exit 1: a report on disk is malformed — its name, summary, or \`rule\` lines"
`;

