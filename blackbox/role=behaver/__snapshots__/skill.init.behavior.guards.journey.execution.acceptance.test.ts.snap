exports[`skill.init.behavior.guards.journey.execution given: [case1] a heavy-guard behavior at its execution stone when: [t0] execution pass attempted without promises then: blocked by unpromised self-review 1`] = `
"🪨 run solid skill repo=bhrain/role=driver/skill=route.stone.set

🦉 the way speaks for itself

🗿 route.stone.set
   ├─ stone = 5.1.execution.phase0_to_phaseN
