   │   └─ taken: .behavior/v{DATE}.full-journey/.reviews/peer/1.vision._.review.i001.{HASH}.r001._.taken.by_self.dimensional-decomposition.md
   │
   ├─ r2: experience-coverage (l1, 1/3)
   │   ├─ approved [time]
   │   ├─ 0 blockers ✓
   │   ├─ 0 nitpicks ✓
   │   ├─ given: .behavior/v{DATE}.full-journey/.reviews/peer/1.vision._.review.i001.{HASH}.r002._.given.by_peer.experience-coverage.md
   │   └─ taken: .behavior/v{DATE}.full-journey/.reviews/peer/1.vision._.review.i001.{HASH}.r002._.taken.by_self.experience-coverage.md
   │
   ├─ ✓ judge.1 - allowed [time]
   │
   └─ ✓ judge.2 - allowed [time]

🗿 route.stone.set
   ├─ stone = 1.vision
   ├─ passage = allowed
   ├─ guard
   │  ├─ artifacts
   │  ├─ reviews
   │  │   ├─ r1: dimensional-decomposition (l1, 1/3)
   │  │   │   ├─ approved [time]
   │  │   │   ├─ 0 blockers ✓
   │  │   │   ├─ 0 nitpicks ✓
   │  │   │   ├─ given: .behavior/v{DATE}.full-journey/.reviews/peer/1.vision._.review.i001.{HASH}.r001._.given.by_peer.dimensional-decomposition.md
   │  │   │   └─ taken: .behavior/v{DATE}.full-journey/.reviews/peer/1.vision._.review.i001.{HASH}.r001._.taken.by_self.dimensional-decomposition.md
   │  │   └─ r2: experience-coverage (l1, 1/3)
   │  │       ├─ approved [time]
   │  │       ├─ 0 blockers ✓
   │  │       ├─ 0 nitpicks ✓
   │  │       ├─ given: .behavior/v{DATE}.full-journey/.reviews/peer/1.vision._.review.i001.{HASH}.r002._.given.by_peer.experience-coverage.md
   │  │       └─ taken: .behavior/v{DATE}.full-journey/.reviews/peer/1.vision._.review.i001.{HASH}.r002._.taken.by_self.experience-coverage.md
   │  └─ judges
   │      ├─ j1: $rhachet run --repo bhrain --skill route.stone.judge --mechanism reviewed? --stone $stone --route $route --allow-blockers 0 --allow-nitpicks 7
   │      │   └─ finished [time] ✓
   │      └─ j2: $rhachet run --repo bhrain --skill route.stone.judge --mechanism approved? --stone $stone --route $route
   │          └─ finished [time] ✓
   │
   └─ the way continues, run
      └─ rhx route.drive"
`;

