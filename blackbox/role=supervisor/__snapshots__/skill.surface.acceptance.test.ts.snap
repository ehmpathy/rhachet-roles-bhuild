exports[`supervisor.surface acceptance (as consumer) given: [case3] the concurrency verbs, invoked by name from a consumer when: [t7] \`rhx git.grove.capacity local\` renders the read then: 🔴 and the read tree holds its shape 1`] = `
"🪨 run solid skill repo=bhuild/role=supervisor/skill=git.grove.capacity

🌲 grove capacity (token cost over 180 min)
   ├─ tokens, fleet-wide: N/h now
   │  ├─ per crew-hour: behavior N · directive ⚪
   │  ├─ 5h: ⚪ the cap ledger holds no rows — wire \`claude.statusline.caplog\` on each seat, then restart it
   │  └─ 7d: ⚪ the cap ledger holds no rows — wire \`claude.statusline.caplog\` on each seat, then restart it
   └─ grove local: 4 cpu · 12G free of 16G · 1 crews live, 1 at work · busy 3 of 4 · 40 forks/s (40 per seat) · cpu stall 🟢 0.00% (since boot 0.400%) · ram full stall 🟢 0.00% (since boot 0.100%)
      ├─ behavior: affordable ~2 (est.) (upper bound) · binds cpu · free slots 1 · ram 11 · cpu ~2 (est.) · tokens_5h ⚪ · tokens_7d ⚪
      ├─ directive: affordable ~2 (est.) (upper bound) · binds cpu · free slots 1 · ram 11 · cpu ~2 (est.) · tokens_5h ⚪ · tokens_7d ⚪ · costs borrowed from the grove median
      └─ exchange: 1 directive ≈ 1 behavior (on cpu) — ⚪ an estimate: a cost is borrowed, so this is no measure

🥥 next
   ├─ ask for a slot: rhx git.grove.capacity --grove <g> --for behavior --key <branch>
   ├─ rank the levers: rhx git.grove.capacity --levers
   └─ calibrate the caps: rhx git.crew.tokens calibrate"
`;

exports[`supervisor.surface acceptance (as consumer) given: [case3] the concurrency verbs, invoked by name from a consumer when: [t8] \`rhx git.grove.capacity --for behavior\` grants a slot, as a tree then: 🔴 and the grant tree holds its shape 1`] = `
"🪨 run solid skill repo=bhuild/role=supervisor/skill=git.grove.capacity

🌲 grove capacity · gate
   ├─ ✅ a behavior slot on local — 0 left after this one (binds: cpu)
   ├─ ⚪ an upper bound: unread axes — tokens_5h, tokens_7d
   └─ held as local.behavior.beav+feat-coachbook for 15 min
      └─ drop it once the sprout boots: rhx git.grove.capacity --release local.behavior.beav+feat-coachbook"
`;

exports[`supervisor.surface acceptance (as consumer) given: [case3] the concurrency verbs, invoked by name from a consumer when: [t9] a second key asks the full box, as a tree then: 🔴 and the full-box refusal tree holds its shape 1`] = `
"🪨 run solid skill repo=bhuild/role=supervisor/skill=git.grove.capacity

🪨 run solid skill repo=bhuild/role=supervisor/skill=git.grove.capacity
   └─ ✋ blocked by constraints

✋ ConstraintError: no behavior slot on local
   ├─ free: 1 · held by sprouts in flight: 1 · binds: cpu
   ├─ held by sprouts in flight — each lapses on its own, or on --release
   │  └─ local.behavior.beav+feat-coachbook · behavior · lapses in N min
   ├─ a hold whose sprout already booted holds its slot twice; drop it: rhx git.grove.capacity --release <hold>
   └─ read every grove's free slots, then sprout where one is free — or seed the wish for later
      ├─ rhx git.grove.capacity
      └─ rhx radio.task.push --via gh.issues --into <org/repo> --title '<title>' --description @stdin"
`;

