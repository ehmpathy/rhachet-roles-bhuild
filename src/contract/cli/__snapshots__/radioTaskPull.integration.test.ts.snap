exports[`radio.task.pull.integration — CLI contract given: [case10] --auth as-ehmpath on bert's laptop: keyrack holds none, the email is human when: [t0] the pull skill lists against a stub gh with a login then: the message matches the snapshot 1`] = `
"✋ ConstraintError: --auth as-ehmpath found no ehmpath token

checked
├─ keyrack: not granted (status: absent)
└─ ambient: git config user.email = bert@example.com, not an ehmpath email

fix
├─ set the robot token: rhx keyrack set --owner ehmpath --key EHMPATH_BEAVER_GITHUB_TOKEN --env prep
└─ or send as yourself, on purpose: --auth as-human

{
  "auth": "as-ehmpath"
}"
`;

exports[`radio.task.pull.integration — CLI contract given: [case11] --auth as-ehmpath-via-keyrack on an ehmpath box: keyrack holds none, gh is logged in when: [t0] the pull skill lists against a stub gh with a login then: the message matches the snapshot 1`] = `
"✋ ConstraintError: --auth as-ehmpath-via-keyrack found no ehmpath token

checked
└─ keyrack: not granted (status: absent)

fix
├─ set the robot token: rhx keyrack set --owner ehmpath --key EHMPATH_BEAVER_GITHUB_TOKEN --env prep
└─ or send as yourself, on purpose: --auth as-human

{
  "auth": "as-ehmpath-via-keyrack"
}"
`;

