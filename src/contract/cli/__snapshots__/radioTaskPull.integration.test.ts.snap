exports[`radio.task.pull.integration — CLI contract given: [case13] --auth as-ehmpath-via-ambient on an ehmpath box whose gh holds no login when: [t0] the pull skill lists against a stub gh with no login then: the message matches the snapshot 1`] = `
"✋ ConstraintError: --auth as-ehmpath-via-ambient found no ehmpath token

checked
└─ ambient: ehmpath email, but gh holds no login

fix
├─ log gh in as the ehmpath account: gh auth login
└─ or send as yourself, on purpose: --auth as-human

{
  "auth": "as-ehmpath-via-ambient"
}"
`;

