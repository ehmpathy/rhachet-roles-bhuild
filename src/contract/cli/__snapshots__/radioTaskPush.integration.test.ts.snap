exports[`radio.task.push.integration — CLI contract given: [case10] --auth with an unrecognized mode when: [t0] the push skill runs then: holds the push as upstream:auth, and lists every supported mode 1`] = `
"🦫 held for the radio
   ├─ task    = auth failure contract
   ├─ into    = test-owner/example
