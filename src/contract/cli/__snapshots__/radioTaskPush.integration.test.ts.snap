// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`radio.task.push.integration — CLI contract given: [case1] --help (the positive usage contract) when: [t0] the push skill runs then: prints the usage + options help text 1`] = `
"🦫 let's check the meter...

🎙️ radio.task.push --help
   ├─ usage
   │  ├─ rhx radio.task.push --via gh.issues --into owner/repo --title "..." --description "..."
   │  ├─ rhx radio.task.push --via os.fileops --into @this --exid 123 --status CLAIMED
   │  ├─ rhx radio.task.push --via gh.issues --into owner/repo --exid 599 --status CLAIMED --auth as-human
   │  └─ echo "details" | rhx radio.task.push --via gh.issues --into @this --title "..." --description @stdin
   │
   ├─ held, never lost
   │  ├─ every push is recorded first, into $route/.radio/ (or .behavior/.radio/)
   │  ├─ a shut gate or an upstream fault holds it QUEUED, exit 2
   │  ├─ the next push that gets through delivers the backlog first, oldest first
   │  ├─ see what waits: rhx radio.task.queue get
   │  └─ lift a shut gate (human): rhx radio.uses allow
   │
   └─ options
      ├─ --via         channel: gh.issues or os.fileops (required)
      ├─ --into        target: @this (current repo) or owner/repo (required)
      ├─ --title       task title (required for new tasks)
      ├─ --description task description (required for new tasks; supports @stdin)
      ├─ --exid        external id for updates
      ├─ --status      status: QUEUED, CLAIMED, DELIVERED
      ├─ --idem        idempotency: findsert or upsert
      ├─ --auth        where the token comes from (default: ambient-first)
      │  ├─ (none)                  by this box's git config user.email
      │  │  ├─ an ehmpath email     its gh login, else keyrack
      │  │  ├─ another email        as-human
      │  │  └─ no email set         keyrack
      │  ├─ as-ehmpath              keyrack, then the gh login (ehmpath email only)
      │  ├─ as-ehmpath-via-keyrack  keyrack only
      │  ├─ as-ehmpath-via-ambient  the gh login only (ehmpath email only)
      │  ├─ as-human                the gh login, any identity
      │  └─ as-robot:via-keyrack(owner) · as-robot:env(VAR) · as-robot:shx(cmd)
      └─ --help, -h    show this help"
`;

exports[`radio.task.push.integration — CLI contract given: [case2] no --via arg when: [t0] the push skill runs then: fails with a ConstraintError that names the channels 1`] = `"✋ ConstraintError: --via is required; specify a channel: --via gh.issues or --via os.fileops"`;

exports[`radio.task.push.integration — CLI contract given: [case3] permission unset (the safe-default blocked gate, push-specific) when: [t0] the push skill runs against an ungranted repo then: holds the push QUEUED, exit 2, and names the grant command 1`] = `
"🦫 held for the radio
   ├─ task    = blocked task
   ├─ into    = test-owner/test-repo-push-blocked
   ├─ status  = QUEUED (radio.uses:blocked — default)
   ├─ held at = .behavior/.radio/ (no route bound to this branch)
   ├─ backlog = 1 awaits the radio
   └─ lift it (human): rhx radio.uses allow
      └─ then the next push delivers the backlog first"
`;

