    "shape": "no budget",
  },
  {
    "fix": "src/domain.roles/sandpine/boot.yml declares \`budget:\` in a shape this clamp cannot read; use \`budget:\\n  tokens: <n>\` or \`budget: { tokens: <n> }\`",
    "shape": "unreadable",
  },
  {
