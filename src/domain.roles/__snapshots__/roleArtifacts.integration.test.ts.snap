exports[`roleArtifacts given: [case5] each declared boot, against the budget it declares when: [t3] a linked copy is forced over its budget then: the halt reads as a human meets it 1`] = `
"🧢 roles boot --what .agent/repo=bhuild/role=decomposer/boot.yml
   ├─ ✋ ConstraintError: over budget
   │  ├─ budget   = <n> tokens   (declared in boot.yml)
   │  ├─ payload  = <n> tokens   (full emitted payload, o200k_base)
   │  └─ over by  = <n> tokens   (<n>% of budget)
   │
   ├─ some resources must go — you choose which
   │  └─ rhx cost --what .agent/repo=bhuild/role=decomposer/boot.yml   sorts every batch by what it costs
   │
   └─ fix — four strategies, cheapest first
      ├─ catalogize  replace a set with one catalog that indexes it
      ├─ condense    author an x.md.min beside x.md
      ├─ reference   move a say entry to ref (it stays addressable, costs its path line)
      └─ eliminate   list what does not earn its boot under \`not\` (the file stays)


✋ ConstraintError: boot payload exceeds its declared budget

{
  "hint": "trim a resource — catalogize a set, condense or ref a say entry, list one under \`not\` — or raise budget.tokens deliberately",
  "budget": <n>,
  "payload": <n>,
  "over": <n>
}

[args] roles,boot,--what,.agent/repo=bhuild/role=decomposer/boot.yml

repro: npx rhachet roles cost --what src/domain.roles/decomposer/boot.yml — the linked render costs a little more than src"
`;

exports[`roleArtifacts given: [case6] the budget clamp, on each shape it must read when: [t1] each budget verdict is named for the author then: each shape names its own fix, and a declared budget owes none 1`] = `
