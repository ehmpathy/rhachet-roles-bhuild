exports[`ductwork.unreachable given: [case1] a hetzner grove (no aws lever) that ssh cannot reach when: [t0] ssh timed out, and the alias is on disk then: the render reads as a snapshot 1`] = `
"✋ duct.read: cannot reach 'grove-sandpine-hetzner-v20261022'
   ├─ what:  ssh itself failed, so the duct was never asked
   ├─ ssh said
   │  ├─
   │  │
   │  │  ssh: connect to host grove-sandpine-hetzner-v20261022-1 port 22: Connection timed out
   │  │
   │  └─
   ├─ cause: the grove is down, asleep, or off the tailnet
   ├─ fix:   check the tailnet — tailscale status (is this machine a peer?), then tailscale ping grove-sandpine-hetzner-v20261022-1
   └─ note:  the session state is UNKNOWN — absent and present are both possible
"
`;

exports[`ductwork.unreachable given: [case1] a hetzner grove (no aws lever) that ssh cannot reach when: [t1] ssh timed out, and this machine never woke it (no alias) then: the render reads as a snapshot 1`] = `
"✋ duct.read: cannot reach 'grove-sandpine-hetzner-v20261022'
   ├─ what:  ssh itself failed, so the duct was never asked
   ├─ ssh said
   │  ├─
   │  │
   │  │  ssh: connect to host grove-sandpine-hetzner-v20261022 port 22: Connection timed out
   │  │
   │  └─
   ├─ cause: the ssh alias does not dial this grove's tailnet host (absent, or a stale alias), so the timeout is not the grove's
   ├─ fix:   write its ssh alias first — rhx git.grove.wake grove-sandpine-hetzner-v20261022 (power none: it touches no aws), then retry
   └─ note:  the session state is UNKNOWN — absent and present are both possible
"
`;

