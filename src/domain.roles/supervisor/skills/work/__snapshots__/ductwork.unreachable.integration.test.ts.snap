// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`ductwork.unreachable given: [case1] a hetzner grove (no aws lever) that ssh cannot reach when: [t0] ssh timed out, and the alias is on disk then: the render reads as a snapshot 1`] = `
"✋ duct.read: cannot reach 'grove-sandpine-hetzner-v20261022'
   ├─ what:  ssh itself failed, so the duct was never asked
   ├─ ssh said
   │  ├─
   │  │
   │  │  ssh: connect to host grove-sandpine-hetzner-v20261022-1 port 22: Connection timed out
   │  │
   │  └─
   ├─ cause: the grove is down, asleep, or off the tailnet
   ├─ fix:   check the tailnet — tailscale status (is this machine a peer?), then tailscale ping grove-sandpine-hetzner-v20261022-1
   └─ note:  the session state is UNKNOWN — absent and present are both possible
"
`;

exports[`ductwork.unreachable given: [case1] a hetzner grove (no aws lever) that ssh cannot reach when: [t2] the bare name was refused as the local user (no alias) then: the render reads as a snapshot 1`] = `
"✋ duct.read: cannot reach 'grove-sandpine-hetzner-v20261022'
   ├─ what:  ssh itself failed, so the duct was never asked
   ├─ ssh said
   │  ├─
   │  │
   │  │  surfer@grove-sandpine-hetzner-v20261022: Permission denied (publickey).
   │  │
   │  └─
   ├─ cause: the endpoint refused our key
   ├─ fix:   write its ssh alias first — rhx git.grove.wake grove-sandpine-hetzner-v20261022 (power none: it touches no aws), then retry
   └─ note:  the session state is UNKNOWN — absent and present are both possible
"
`;

exports[`ductwork.unreachable given: [case1] a hetzner grove (no aws lever) that ssh cannot reach when: [t5] the box refused the connect (no sshd on its port) then: the render reads as a snapshot 1`] = `
"✋ duct.read: cannot reach 'grove-sandpine-hetzner-v20261022'
   ├─ what:  ssh itself failed, so the duct was never asked
   ├─ ssh said
   │  ├─
   │  │
   │  │  ssh: connect to host grove-sandpine-hetzner-v20261022-1 port 22: Connection refused
   │  │
   │  └─
   ├─ cause: the box answered, and no sshd listens on its port
   ├─ fix:   is sshd up on the grove, and is the row's port its sshd? see where it stops — ssh -v 'grove-sandpine-hetzner-v20261022'
   └─ note:  the session state is UNKNOWN — absent and present are both possible
"
`;

exports[`ductwork.unreachable given: [case2] an ec2 grove whose alias on disk is the ssm-era relic (localhost:36903) when: [t0] ssh is refused at the dead tunnel port then: the render reads as a snapshot 1`] = `
"✋ duct.read: cannot reach 'grove-sandpine-v20260901'
   ├─ what:  ssh itself failed, so the duct was never asked
   ├─ ssh said
   │  ├─
   │  │
   │  │  ssh: connect to host localhost port 36903: Connection refused
   │  │
   │  └─
   ├─ cause: the ssh alias does not dial this grove's tailnet host (absent, or an ssm-era relic), so the refusal is not the grove's
   ├─ fix:   wake it — rhx git.grove.wake grove-sandpine-v20260901 (it writes the ssh alias every crew verb rides)
   └─ note:  the session state is UNKNOWN — absent and present are both possible
"
`;
