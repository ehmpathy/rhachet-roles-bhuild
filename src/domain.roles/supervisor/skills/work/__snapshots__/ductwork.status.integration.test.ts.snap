exports[`ductwork.status given: [case7] duct.bar.probe audits a pinned bar, an unpinned one, and a dead server when: [t0] the probe runs over the private socket dir then: the render matches the snapshot 1`] = `
"
🦫 chew on it

🪵 duct.bar.probe
   ├─ servers: 2 ($SOCKDIR/tmux-<uid>)
   ├─ svc-lessons-feat-x/foreman (server live)
   │  ├─ shown: [  |  ]
   │  ├─ status-left: session=[ #{@repo} ] global=[ #{@repo} ]
   │  ├─ window-status-format (global): []
   │  ├─ @duct_repo (resolved)=[] pane @repo=[]
   │  └─ pinned to duct: no
   ├─ testtree/mechanic (server live)
   │  ├─ shown: [ svc-lessons | feat/book-a-lesson ]
   │  ├─ status-left: session=[ #{@duct_repo} ] global=[ #{@repo} ]
   │  ├─ window-status-format (global): []
   │  ├─ @duct_repo (resolved)=[svc-lessons] pane @repo=[svc-lessons]
   │  └─ pinned to duct: yes
   ├─ 🟡 server stale did not answer: its sessions are unread (a stale socket, or a server that died)
   └─ done: 2 sessions, 1 server unread
RC=0
"
`;

exports[`ductwork.status given: [case7] duct.bar.probe audits a pinned bar, an unpinned one, and a dead server when: [t1] the caller asks how to use the probe then: the help render matches the snapshot 1`] = `
".what = read, per duct session on this box, what its tmux bar draws and
        what it is wired to read

.why  = "the bar shows the wrong label" has two causes that look alike:
        the bar reads a pane option a shell hook overwrites, or the bar was
        never pinned to the duct at all. this tells them apart in one call,
        on every tmux server here (ducts sit one server per org)

usage:
  duct.bar.probe.sh                  # every tree/role session on every server
  duct.bar.probe.sh --session <s>    # one session

guarantee:
  - reads only: list-sessions, display-message, show-options; never sets
  - exit 0 = probed (findings are reported, never an error)
  - exit 2 = bad args, or no tmux on this box
RC=0
"
`;

exports[`ductwork.status given: [case7] duct.bar.probe audits a pinned bar, an unpinned one, and a dead server when: [t2] the caller mistypes an arg then: the refusal render matches the snapshot 1`] = `
"RC=2
✋ ConstraintError: unknown arg '--sesion'
   ├─ valid args: --session <tree>/<role> · --help
   └─ fix: rhx duct.bar.probe --session <tree>/<role>   # or bare, for every session
"
`;

