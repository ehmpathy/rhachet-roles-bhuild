PWNED=no
"
`;

exports[`ductwork.status given: [case9] a grove duct on a branch whose name holds shell syntax when: [t1] a duct uri itself holds shell syntax then: the refusal render matches the snapshot 1`] = `
"✋ ConstraintError: duct: 'duct://grove-h/x';touch ??$ROOT/pwned;'/mechanic' holds a single quote or a control char (shown as ?), which a duct name may not
   └─ fix: name the duct by its tree and role — duct://<grove>/<tree>/<role>
✋ ConstraintError: duct.read: --lines '5';touch ??$ROOT/pwned;'' is not a count
   └─ fix: pass a whole number, e.g. --lines 60
✋ ConstraintError: duct.send: --keys 'Enter;touch ??$ROOT/pwned' holds a char a tmux key name may not
   ├─ allowed: letters, digits, space, and _ + -   (e.g. Enter, C-c, Escape, 2)
   └─ fix: send text with --what; --keys is for named keys
"
`;

exports[`ductwork.status given: [case9] a grove duct on a branch whose name holds shell syntax when: [t2] a grove duct is born in a dir whose name holds shell syntax then: the render matches the snapshot 1`] = `
"open cwd
RC=0
PWNED_CWD=no
BORN_IN=$ROOT/svc-lessons.feat.x
BORN_IN=$ROOT/at';touch\\\${IFS}$ROOT/pwned-cwd;'
"
`;

