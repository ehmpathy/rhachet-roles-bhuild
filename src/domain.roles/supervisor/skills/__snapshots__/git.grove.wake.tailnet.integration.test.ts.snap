// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`git.grove.wake.tailnet given: [case1] a hetzner grove — no aws lever, a tailnet host when: [t0] it is woken and ssh answers then: the wake reads as a snapshot 1`] = `
"🐢 heres the wave...

🌳 git.grove.wake grove-sandpine-hetzner-v20261022 --mode apply
   ├─ power: none — no aws lever; this grove does not sleep
   ├─ reach: camper@grove-sandpine-hetzner-v20261022-1:22, over the tailnet
   └─ drive
      ├─ ssh  answered as camper@grove-sandpine-hetzner-v20261022-1:22
      └─ ssh  [SET] alias 'grove-sandpine-hetzner-v20261022' written (camper@grove-sandpine-hetzner-v20261022-1:22)

🌳 grove's awake!
   ├─ reach:  camper@grove-sandpine-hetzner-v20261022-1:22, over the tailnet
   └─ reach it with:
      ├─ ssh grove-sandpine-hetzner-v20261022
      └─ rhx git.grove.send grove-sandpine-hetzner-v20261022 --what '<cmd>'
"
`;

exports[`git.grove.wake.tailnet given: [case1] a hetzner grove — no aws lever, a tailnet host when: [t1] it is woken and ssh does not answer then: the failure reads as a snapshot 1`] = `
"      ├─ 💥 no ssh answer from camper@grove-sandpine-hetzner-v20261022-1:22 within 0s

  ssh said:
    ssh: connect to host grove-sandpine-hetzner-v20261022-1 port 22: Connection timed out

  first, is THIS machine on the tailnet? a caller off it reaches no grove —
    check the tailnet — tailscale status (is this machine a peer?), then tailscale ping grove-sandpine-hetzner-v20261022-1
  a grove rebuilt joins the tailnet under a new \`-N\` suffix, and shows in that list;
  pin the live name as the row's host —
    git grove set grove-sandpine-hetzner-v20261022 --at camper@<tailnet-host>:22

  if the tailnet checks pass, the box may be STARVED:

  (b) 🔴 it is STARVED. a box thrashed under load cannot answer a handshake,
      so a second wake cures NAUGHT, and each one costs another 0s
      tell: git.grove.list reads 🔴 MUTE — the port accepts, yet no ssh
            banner comes back — rather than 🔴 DOWN, and saturation
            reads a full run queue
        rhx git.grove.list
        rhx git.grove.saturation grove-sandpine-hetzner-v20261022
      fix: the lever is LOAD — fell or stop crews, or provision more box.
           🟡 neither is reachable while it is mute, so this is a
           PROVISION decision for a human
"
`;

exports[`git.grove.wake.tailnet given: [case1] a hetzner grove — no aws lever, a tailnet host when: [t2] it is planned then: the plan reads as a snapshot 1`] = `
"🐢 heres the wave...

🌳 git.grove.wake grove-sandpine-hetzner-v20261022 --mode plan
   ├─ power: none — no aws lever; this grove does not sleep
   ├─ reach: camper@grove-sandpine-hetzner-v20261022-1:22, over the tailnet
   └─ drive
      └─ plan: re-run without --mode plan to wake (no ssh, no alias in plan)
"
`;

exports[`git.grove.wake.tailnet given: [case1] a hetzner grove — no aws lever, a tailnet host when: [t4] it is woken from a machine that is not a tailnet peer then: the halt reads as a snapshot 1`] = `
"      ├─ ✋ ConstraintError: this machine is not a tailnet peer — tailscale status failed

  tailscale said:
    Logged out.

  fix: rejoin the camp tailnet, then wake again —
    tailscale up
    rhx git.grove.wake grove-sandpine-hetzner-v20261022
"
`;

exports[`git.grove.wake.tailnet given: [case1] a hetzner grove — no aws lever, a tailnet host when: [t5] the box answers, and refuses our key then: the halt reads as a snapshot 1`] = `
"      ├─ ✋ ConstraintError: camper@grove-sandpine-hetzner-v20261022-1:22 answered, and refused our key

  ssh said:
    camper@grove-sandpine-hetzner-v20261022-1: Permission denied (publickey).

  fix: the tailnet reached it — the key is the cause. is the public half of
       $HOME_TMP/home/.ssh/id_ed25519 in camper's authorized_keys on the grove? see where it stops —
    ssh -v -i $HOME_TMP/home/.ssh/id_ed25519 -p 22 camper@grove-sandpine-hetzner-v20261022-1 true
"
`;

exports[`git.grove.wake.tailnet given: [case1] a hetzner grove — no aws lever, a tailnet host when: [t7] the box refuses the connect (no sshd on its port) then: the halt reads as a snapshot 1`] = `
"      ├─ ✋ ConstraintError: grove-sandpine-hetzner-v20261022-1 answered on 22, and refused the connect

  ssh said:
    ssh: connect to host grove-sandpine-hetzner-v20261022-1 port 22: Connection refused

  fix: the box answered on 22 and refused — is sshd up there, and is 22 its port? (a stale ssm-era port reads this way; re-register — git grove set grove-sandpine-hetzner-v20261022 --at camper@grove-sandpine-hetzner-v20261022-1:22)
"
`;

exports[`git.grove.wake.tailnet given: [case2] an ec2 grove whose row is an ssm-era relic, box up when: [t0] it is woken with live credentials then: the wake reads as a snapshot 1`] = `
"🐢 heres the wave...

🌳 git.grove.wake grove-sandpine-v20260901 --mode apply
   ├─ exid:  grove-sandpine-v20260901
   ├─ power: aws
   ├─ reach: camper@grove-sandpine-v20260901:22, over the tailnet
   ├─ env:   camp
   ├─ account: 000000000000 ✔ matches the registry
   └─ drive
      ├─ box  i-0sandpine0000001 [KEEP] already up
      ├─ ssh  answered as camper@grove-sandpine-v20260901:22
      ├─ ssh  [REPLACE] alias 'grove-sandpine-v20260901' differs from the registry (camper@grove-sandpine-v20260901:22)
      └─ ssh  [SET] alias 'grove-sandpine-v20260901' written (camper@grove-sandpine-v20260901:22)

🌳 grove's awake!
   ├─ box:    i-0sandpine0000001 (exid=grove-sandpine-v20260901, account 000000000000)
   ├─ reach:  camper@grove-sandpine-v20260901:22, over the tailnet
   └─ reach it with:
      ├─ ssh grove-sandpine-v20260901
      └─ rhx git.grove.send grove-sandpine-v20260901 --what '<cmd>'
"
`;

exports[`git.grove.wake.tailnet given: [case2] an ec2 grove whose row is an ssm-era relic, box up when: [t1] it is woken again, with the alias already converged then: the converged render reads as a snapshot 1`] = `
"🐢 heres the wave...

🌳 git.grove.wake grove-sandpine-v20260901 --mode apply
   ├─ exid:  grove-sandpine-v20260901
   ├─ power: aws
   ├─ reach: camper@grove-sandpine-v20260901:22, over the tailnet
