// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`git.grove.keyrack given: [case] a literal --value when: [t0] the skill is invoked then: the refusal matches its snapshot 1`] = `
"✋ ConstraintError: git.grove.keyrack: --value must be @stdin, never a literal
   why: an argv is world-readable on this box (ps), lands in shell
        history, and rides into any log that echoes the command.
        a secret that reaches argv is a secret you must rotate.
   fix: pipe it —
     rhx keyrack get --owner ehmpath --key K --env prep --value \\
       | rhx git.grove.keyrack set grove-1 --org sandpine --key K --env prep --value @stdin
"
`;

exports[`git.grove.keyrack given: [case] a remote grove reached over a real ssh hop when: [t0] a value is piped in, to the os.direct vault then: the success tree matches its snapshot 1`] = `
"🦫 chew on it

🔑 git.grove.keyrack set cloud://grove-loop
   ├─ 🌳 grove: grove-loop
   ├─ 🏢 org: sandpine
   ├─ 🔑 key: LESSON_API_KEY
   ├─ 🌍 env: prep
   ├─ 👤 owner: bert
   └─ 📏 value: 17 bytes (never printed)

🔌 reach the grove
   └─ 🟢 reached grove-loop

🔎 a repo of 'sandpine' on the grove
   ├─ found: $HOME/git/sandpine/svc-lessons
   └─ 🟢 it declares org: sandpine

📤 set sandpine.prep.LESSON_API_KEY on the grove
   ├─ 🔐 keyrack set (org: sandpine, env: prep)
   │     └─ sandpine.prep.LESSON_API_KEY
   │        ├─ mech: PERMANENT_VIA_REPLICA
   │        └─ vault: os.direct
   │
   ├─ 🔍 read it back to prove the VALUE landed, not merely the config
   └─ 🟢 sha256 matches — the same bytes landed

🌊 sandpine.prep.LESSON_API_KEY is set on grove-loop
   └─ a clone there reads it after: rhx keyrack unlock --owner bert --env prep
"
`;

