// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`git.grove.saturation.reach given: [case1] one ec2 grove registered twice: camper, and .ground when: [t0] the sweep reads it then: the refused render reads as a snapshot 1`] = `
"🌲 grove saturation

🌳 grove-sandpine-v20260901
   └─ 🔴 refused — the box answered on 1 and refused — is sshd up there, and is 1 its port? (a stale port in the row reads this way; re-register — git grove set grove-sandpine-v20260901 --at camper@127.0.0.2:22)

   🟢 headroom   🟡 tight   🔴 saturated   ⚪ not measured
   stall = the share of time work WAITED on that resource (kernel PSI).
   'some' = at least one task waited
   'full'  = every NON-IDLE task stalled — a ratio, and idle tasks leave
             the denominator. a clone awaiting the network counts as idle,
             so a high 'full' can sit beside a fleet that feels fast.
             read it as CONTENTION AMONG THE RUNNABLE, never as throughput.
"
`;

