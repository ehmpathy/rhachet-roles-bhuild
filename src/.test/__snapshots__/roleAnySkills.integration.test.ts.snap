usage: grove.census.sh [--window <min> | --since <iso> [--until <iso>]] [--sample <sec>] [--json]

  --window <min>   token burn window, in minutes back from now (default 60)
  --since <iso>    token burn from this instant (utc), in place of --window
  --until <iso>    token burn up to this instant (utc; default now)
  --sample <sec>   fork-rate sample length, in seconds (default 30)
  --json           emit one json record in place of the tree

[stderr]
"
`;

