exports[`initBehaviorDir.integration given: [case1] guard level is light (default) when: [t0] initBehaviorDir is called without guard arg then: the wisher-how blocks match across light and heavy 6`] = `
{
  "block": "- slug: has-restated-the-wisher-how
      say: |
        did the criteria trust the wish's how, or only its why and rough contract?
        read \`rule.forbid.trust-of-wisher-how\` before you grade.

