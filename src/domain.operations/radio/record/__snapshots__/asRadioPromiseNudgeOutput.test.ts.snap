exports[`asRadioPromiseNudgeOutput given: [case3] a visibility read that failed on the auth when: [t0] the nudge renders then: it leads with the as-human re-run, and its command has no promise 1`] = `
"🦫 hold up — this task may go to a public repo
   ├─ repo: sandpine/svc-lessons (visibility unreadable on this auth — try as-human)
   │  └─ cause: github auth failed: the robot token was rejected by github (401)
   ├─ first: re-run with --auth as-human; a private repo then sends with no promise
   ├─ or, with no human login or a public repo: check the text, then add --promise task-to-public-repo-is-anonymized instead
   ├─ the title and body must hold none of
   │  ├─ the source org, repo, route path, or pr / issue numbers
   │  ├─ internal endpoint, service, table or product names
   │  └─ customer, revenue or other business detail
   └─ this push: naught sent, naught queued; once checked, re-run the command below

rhx radio.task.push --via gh.issues --into sandpine/svc-lessons --title 'lesson reminder flakes' --description 'the 9am reminder sends twice' --auth as-human"
`;

