exports[`asRadioAmendOutput given: [case1] an amend of the auth when: [t0] the amend renders then: it names the auth change, before → after 1`] = `
"🦫 amended the held record
   ├─ uuid    = a1b2c3d4e5f60718
   ├─ task    = lesson reminders → sandpine/svc-lessons
   ├─ changed
   │  └─ auth: default (as-robot:via-keyrack(ehmpath)) → as-human
   ├─ kept at = .behavior/.radio/record.a1b2c3d4e5f60718.json
   └─ naught sent; its place in line is kept, and the next push, or \`rhx radio.task.queue drain\`, sends it; a public repo needs \`drain --promise task-to-public-repo-is-anonymized\`, once checked"
`;

