exports[`asRadioDrainSections given: [case3.1] a record at a shut gate beside a record set aside on auth when: [t0] the sections render then: the lift sits under the gated row only, never beside the faulted one 1`] = `
{
  "closedOrHeld": [
    {
      "children": [
        "a1b2c3d4e5f60718 lesson reminders → sandpine/svc-lessons (radio.uses:blocked — default)
└─ lift it (human): rhx radio.uses allow",
        "b1b2c3d4e5f60718 board rentals → sandpine/svc-lessons (upstream:auth)
├─ fault: github auth failed: the robot token was rejected (401)
├─ amend it: rhx radio.task.queue set --key b1b2c3d4e5f60718 --auth as-human (needs a gh login on this host)
└─ or drop it: rhx radio.task.queue del --key b1b2c3d4e5f60718 --why "<why>"",
      ],
      "line": "still held",
    },
  ],
  "drained": [],
}
`;

