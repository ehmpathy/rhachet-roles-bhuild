}"
`;

exports[`getGithubTokenByAuthArg.asehmpath given: [case5] as-ehmpath, keyrack locked, ambient email ehmpath, gh holds no login when: [t0] the derive runs then: refuses, and names gh auth login as a fix 1`] = `
"✋ ConstraintError: --auth as-ehmpath found no ehmpath token

checked
├─ keyrack: not granted (status: locked)
└─ ambient: ehmpath email, but gh holds no login

fix
├─ unlock the robot token: rhx keyrack unlock --owner ehmpath --key EHMPATH_BEAVER_GITHUB_TOKEN --env prep
├─ log gh in as the ehmpath account: gh auth login
└─ or send as yourself, on purpose: --auth as-human

{
  "auth": "as-ehmpath"
}"
`;

