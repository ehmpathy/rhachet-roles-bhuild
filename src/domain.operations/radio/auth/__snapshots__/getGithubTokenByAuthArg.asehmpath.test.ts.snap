exports[`getGithubTokenByAuthArg.asehmpath given: [case3] as-ehmpath, keyrack locked, ambient email is a human one when: [t0] the derive runs then: refuses, names both spots and the fixes, never reads gh 1`] = `
"✋ ConstraintError: --auth as-ehmpath found no ehmpath token

checked
├─ keyrack: not granted (status: locked)
└─ ambient: git config user.email = bert@example.com, not an ehmpath email

fix
├─ unlock the robot token: rhx keyrack unlock --owner ehmpath --key EHMPATH_BEAVER_GITHUB_TOKEN --env prep
└─ or send as yourself, on purpose: --auth as-human

{
  "auth": "as-ehmpath"
}"
`;

